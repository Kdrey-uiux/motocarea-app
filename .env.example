# MotoCare Frontend Environment Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Cloudflare Turnstile site key (public). Leave empty to turn the "verify you are human" check off.
# Turn CAPTCHA on in Supabase (Authentication -> Attack Protection) only AFTER this key is deployed.
VITE_TURNSTILE_SITE_KEY=

# Google OAuth Web client ID (public), the same one set in Supabase -> Auth -> Providers -> Google.
# With it, the login page shows Google's own button and the Google window names this site.
# Leave empty to keep the redirect sign-in (Google then shows the Supabase project address).
VITE_GOOGLE_CLIENT_ID=
