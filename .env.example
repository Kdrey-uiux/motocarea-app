# MotoCare Frontend Environment Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
VITE_API_URL=http://localhost:5000/api

# Cloudflare Turnstile site key (public). Leave empty to turn the "verify you are human" check off.
# Turn CAPTCHA on in Supabase (Authentication -> Attack Protection) only AFTER this key is deployed.
VITE_TURNSTILE_SITE_KEY=
